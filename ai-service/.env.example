# Server configuration
PORT=8000

# Express Backend API (strictly read-only product lookup)
BACKEND_BASE_URL=http://localhost:3000

# Google Gemini API (server-side only; NEVER commit real keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_CALLS_PER_MINUTE=30

# Chatbot stock and catalog fallback configuration
LOW_STOCK_THRESHOLD=5
AUTO_REPLY_STOCK_ENABLED=true
USE_SAMPLE_PRODUCTS_FALLBACK=true

# Optional API key for protecting public endpoints via X-API-Key header (leave empty locally)
AI_SERVICE_API_KEY=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
